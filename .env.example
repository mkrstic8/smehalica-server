# Пример подешавања. Ништа од овога није обавезно —
# сервер ради и без иједне промењиве.
# Локално: копирај у .env и учитај, или само извези у shell-у.

# Порт (Render га сам поставља)
PORT=3000

# Дозвољени origin за Socket.IO (за Андроид апликацију остави *)
# CORS_ORIGIN=*

# Ако клијент и сервер НИСУ на истом домену, овде се одобрава
# одредиште WebSocket везе у Content-Security-Policy заглављу.
# CSP_CONNECT_SRC='self' ws: wss:

# Колико сервер чека играча који је изгубио везу пре аутоматске предаје (ms)
# DISCONNECT_GRACE_MS=300000

# Искључи праћење промена у serbian-words.txt (0 = искључено)
# WATCH_DICTIONARY=1
